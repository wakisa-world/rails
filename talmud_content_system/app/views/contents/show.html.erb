<style>
  .back-link { font-size: 0.85rem; color: #718096; margin-bottom: 2rem; display: block; }
  .content-header { margin-bottom: 2.5rem; }
  .content-header .category-tag { font-size: 0.8rem; color: #718096; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
  .content-header h1 { font-size: 1.6rem; line-height: 1.4; margin-bottom: 0.5rem; }
  .content-header .source { font-size: 0.85rem; color: #a0aec0; }
  .section { margin-bottom: 3rem; }
  .section-label { font-size: 0.75rem; letter-spacing: 0.1em; color: #a0aec0; text-transform: uppercase; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; }
  .x-post-box { background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem 1.5rem; white-space: pre-line; font-size: 0.95rem; line-height: 1.7; }
  .x-post-meta { font-size: 0.75rem; color: #a0aec0; margin-top: 0.75rem; text-align: right; }
  .free-note-title { font-size: 1.2rem; font-weight: bold; margin-bottom: 1.5rem; }
  .prose h1, .prose h2, .prose h3 { margin: 1.5rem 0 0.75rem; font-weight: bold; line-height: 1.4; }
  .prose h1 { font-size: 1.3rem; }
  .prose h2 { font-size: 1.1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.4rem; }
  .prose h3 { font-size: 1rem; }
  .prose p { margin-bottom: 1rem; }
  .prose ul, .prose ol { margin: 1rem 0 1rem 1.5rem; }
  .prose li { margin-bottom: 0.3rem; }
  .prose blockquote { border-left: 3px solid #e2e8f0; padding-left: 1rem; color: #718096; margin: 1.25rem 0; }
  .prose strong { font-weight: bold; }
  .prose hr { border: none; border-top: 1px solid #e2e8f0; margin: 2rem 0; }
  .paid-cta { background: #1a202c; color: #e2e8f0; border-radius: 8px; padding: 2rem; text-align: center; }
  .paid-cta h3 { font-size: 1.1rem; margin-bottom: 0.75rem; color: white; }
  .paid-cta p { font-size: 0.9rem; color: #a0aec0; line-height: 1.7; }
  .published-date { font-size: 0.8rem; color: #a0aec0; margin-top: 0.5rem; }
</style>

<%= link_to "← 一覧へ", contents_path, class: "back-link" %>

<div class="content-header">
  <div class="category-tag"><%= @content.theme_category %></div>
  <h1><%= @content.title %></h1>
  <% if @content.source.present? %>
    <div class="source">出典：<%= @content.source %></div>
  <% end %>
  <% if @content.published_at %>
    <div class="published-date"><%= @content.published_at.strftime("%Y年%-m月%-d日") %></div>
  <% end %>
</div>

<%# X投稿 %>
<div class="section">
  <div class="section-label">X 投稿</div>
  <div class="x-post-box"><%= @content.x_post %></div>
  <div class="x-post-meta"><%= @content.x_post_length %> 文字 / 280文字</div>
</div>

<%# 無料note %>
<div class="section">
  <div class="section-label">無料 note</div>
  <div class="free-note-title"><%= @content.free_note_title %></div>
  <div class="prose"><%= markdown(@content.free_note_body) %></div>
</div>

<%# 有料note（タイトルのみ表示） %>
<div class="section">
  <div class="section-label">有料 note</div>
  <div class="paid-cta">
    <h3><%= @content.paid_note_title %></h3>
    <p>この問いの本質と、現代の仕事・価格設定・信用構築への応用は有料noteで。</p>
  </div>
</div>
