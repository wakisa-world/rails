<style>
  .page-title { font-size: 1.5rem; font-weight: bold; margin-bottom: 0.5rem; letter-spacing: 0.03em; }
  .page-subtitle { color: #718096; font-size: 0.9rem; margin-bottom: 2rem; }
  .category-filter { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .category-filter a { font-size: 0.8rem; padding: 0.3rem 0.75rem; border: 1px solid #cbd5e0; border-radius: 99px; color: #4a5568; }
  .category-filter a.active, .category-filter a:hover { background: #2d3748; color: white; border-color: #2d3748; }
  .content-list { display: flex; flex-direction: column; gap: 2rem; }
  .content-card { border-bottom: 1px solid #e2e8f0; padding-bottom: 2rem; }
  .content-card .category-tag { font-size: 0.75rem; color: #718096; letter-spacing: 0.05em; margin-bottom: 0.4rem; }
  .content-card h2 { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .content-card .source { font-size: 0.8rem; color: #a0aec0; margin-bottom: 0.75rem; }
  .content-card .x-preview { font-size: 0.9rem; color: #4a5568; background: #f7fafc; border-left: 3px solid #e2e8f0; padding: 0.75rem 1rem; white-space: pre-line; margin-bottom: 1rem; }
  .content-card .read-more { font-size: 0.85rem; }
  .empty-state { color: #a0aec0; padding: 3rem 0; text-align: center; }
</style>

<h1 class="page-title">コンテンツ一覧</h1>
<p class="page-subtitle">タルムードの問いから、現代の思考へ。</p>

<div class="category-filter">
  <%= link_to "すべて", contents_path, class: (params[:category].blank? ? "active" : "") %>
  <% Content::THEME_CATEGORIES.each do |cat| %>
    <%= link_to cat, contents_path(category: cat), class: (params[:category] == cat ? "active" : "") %>
  <% end %>
</div>

<% if @contents.any? %>
  <div class="content-list">
    <% @contents.each do |content| %>
      <div class="content-card">
        <div class="category-tag"><%= content.theme_category %></div>
        <h2><%= link_to content.title, content_path(content) %></h2>
        <% if content.source.present? %>
          <div class="source">出典：<%= content.source %></div>
        <% end %>
        <div class="x-preview"><%= truncate(content.x_post, length: 120, omission: "…") %></div>
        <div class="read-more"><%= link_to "続きを読む →", content_path(content) %></div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">公開中のコンテンツはまだありません。</div>
<% end %>
